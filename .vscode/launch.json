{
	"version": "0.2.0",
    "configurations": [
		{
			"name": "Launch (macOS)",
			"type": "lldb-dap",
			"request": "launch",
			"program": "${command:cmake.launchTargetPath}",
			"args": [],
			"cwd": "${command:cmake.getLaunchTargetDirectory}",
	
			"env": {
				"METAL_DEVICE_WRAPPER_TYPE": "5",
				"METAL_ERROR_MODE": "0",
				"METAL_DEBUG_ERROR_MODE": "0",
				"METAL_DEVICE_FORCE_COMMAND_BUFFER_ENHANCED_ERRORS": "1",
				"METAL_DIAGNOSTICS_ENABLED": "1",
				"METAL_SHADER_VALIDATION": "1"
			}
		},
		{
			"name": "Launch",
			"type": "cppdbg",
			"request": "launch",
			"program":"${command:cmake.launchTargetPath}",
			"linux": {
				"MIMode": "gdb"
			},
			"windows": {
				"console": "integratedTerminal",
				"internalConsoleOptions": "openOnSessionStart"
			},
			"args": [],
			"stopAtEntry": false,
			"cwd": "${command:cmake.getLaunchTargetDirectory}",
			"externalConsole": false,
			"MIMode": "lldb"
		}
    ]
}